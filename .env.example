# =========================================================================
# LabLens — Environment Configuration Example
# =========================================================================
# Copy this file to '.env.local' and supply your keys to enable live services.
# If these variables are not supplied, LabLens will automatically run in
# high-fidelity Demo Mode using simulated OCR & mock database caches.

# 1. Google Gemini API Config
# Obtain a key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Supabase Integration Config
# Obtain values from your Supabase Project dashboard API Settings.
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_client_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here
